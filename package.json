{
  "name": "coc7th-character-sheet-printer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "いあきゃらの7版テキスト出力を正規化済みキャラクターシートPDFへ変換するCLI",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build:template": "node scripts/build-template.mjs",
    "build:web": "vite build && node scripts/verify-web-artifact.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "verify:template": "node scripts/verify-template.mjs",
    "print": "node scripts/print-character.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-jp": "^0.4.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "vite": "^7.3.6"
  }
}
